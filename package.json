{
	"name": "svelte-convex-starter",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && bun run lint:svelte5",
		"lint:svelte5": "node scripts/check-svelte5.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "bun run test:unit",
		"convex:dev": "convex dev",
		"convex:codegen": "convex codegen",
		"verify": "bun run check && bun run lint && bun run test && bun run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "1.5.1",
		"svelte": "5.57.0",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0 <2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.37.0",
		"bits-ui": "2.19.0",
		"convex": "1.45.0",
		"convex-svelte": "0.14.0"
	}
}
