# Optional browser-visible URL. Leave empty for the unlinked demo.
# Run `bun run convex:dev`; use the resulting URL from your own deployment.
PUBLIC_CONVEX_URL=

# Your public HTTPS origin (no path). Enables canonical/absolute sharing URLs.
# Leave empty until you choose a domain; unconfigured pages are noindex.
PUBLIC_SITE_URL=

# Optional server capabilities. Credentials are needed only when used.
# Set these in the runtime executing the adapter (Convex OR SvelteKit server).
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=doku
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# Recipe-only until the application's auth / cloud integration is implemented.
AUTH_ENABLED=false
GCP_ENABLED=false

# Convex CLI writes CONVEX_DEPLOYMENT to .env.local when linking locally.
# Never commit .env.local or copy a production deploy key into it.
# CONVEX_DEPLOY_KEY belongs in the hosting provider's secret environment:
# production key for Production only, preview key for Preview only.
# Backend secrets belong on the Convex deployment (`bunx convex env set`).
